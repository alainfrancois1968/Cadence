# Qobuz credentials
# Copy to .env and fill in

# Option 1: email + password (password should be MD5-hashed in some clients;
# the crate may handle hashing — check docs)
QOBUZ_EMAIL=your@email.com
QOBUZ_PASSWORD=your_password

# Option 2: existing user token
# QOBUZ_USER_ID=
# QOBUZ_USER_AUTH_TOKEN=

# Optional: if auto-extraction from web player fails
# QOBUZ_APP_ID=
# QOBUZ_APP_SECRET=
